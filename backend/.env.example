# Entorno ('development' para local, 'production' para despliegue en Render)
NODE_ENV="development"
PORT=3000
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/psicolau?schema=public&connection_limit=5&pool_timeout=20"
JWT_SECRET="TU_SECRETO_SUPER_SEGURO_PARA_JWT"
RESEND_API_KEY="TU_API_KEY_DE_RESEND"

# En desarrollo: http://localhost:5500 o http://127.0.0.1:5500
# En producción (Render): https://psicolau.com
FRONTEND_URL="http://localhost:5500"

# Configuración de Correo Electrónico (Dominio psicolau.com verificado)
REMITENTE="PsicoLau <contacto@psicolau.com>"
CORREO_LAURA="lince_lg@yahoo.com.mx"

# Clave de cifrado AES-256-GCM para Expedientes Clínicos (32 bytes en hexadecimal = 64 caracteres)
# Generar en terminal con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="TU_CLAVE_HEX_DE_32_BYTES_AQUI"

