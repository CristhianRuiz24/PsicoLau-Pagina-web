# Cabeceras globales de seguridad para todas las rutas
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: same-origin

# CSP estricto (Grado A+ Mozilla Observatory) para las páginas públicas
/
  Content-Security-Policy: default-src 'self'; upgrade-insecure-requests; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://i.ytimg.com; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://api.psicolau.com https://cloudflareinsights.com; form-action 'self'; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none';

